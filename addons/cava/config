## cava config rendered by wallust (wallflow addon). Colours update on every wallpaper change.
[general]
framerate = 60
bars = 0
sensitivity = 100

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = stereo

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '{{color4}}'
gradient_color_2 = '{{color6}}'
gradient_color_3 = '{{color2}}'
gradient_color_4 = '{{color3}}'
gradient_color_5 = '{{color5}}'
gradient_color_6 = '{{color1}}'

[smoothing]
noise_reduction = 77
