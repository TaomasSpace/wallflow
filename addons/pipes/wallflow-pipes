#!/usr/bin/env bash
# pipes.sh wrapper: pipes.sh resets the terminal (RIS) when full, which makes
# foot fall back to the palette it loaded at startup. Run it with reset disabled
# and restart it ourselves every $1 seconds, re-applying the current colours.
interval="${1:-300}"; shift
while :; do
    timeout "$interval" pipes.sh -r 0 "$@"
    cat ~/.cache/wallflow/sequences 2>/dev/null
    printf '\e[H\e[2J'
done
